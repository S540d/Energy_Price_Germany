{
  "name": "energypricegermany",
  "version": "1.11.1",
  "description": "Energy price visualization for Germany with market data and renewable energy share",
  "main": "index.ts",
  "homepage": "https://s540d.github.io/Energy_Price_Germany/",
  "repository": {
    "type": "git",
    "url": "https://github.com/S540d/Energy_Price_Germany.git"
  },
  "bugs": {
    "url": "https://github.com/S540d/Energy_Price_Germany/issues"
  },
  "license": "MIT",
  "author": "S540d",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint \"**/*.{ts,tsx}\" \"scripts/**/*.js\"",
    "lint:fix": "eslint \"**/*.{ts,tsx}\" \"scripts/**/*.js\" --fix",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx}\"",
    "build": "expo export --platform web && node scripts/post-build.js && node update-cache-version.js",
    "build:web": "cross-env EXPO_ENV=production npm run build",
    "build:production": "cross-env EXPO_ENV=production npm run build",
    "build:staging": "cross-env EXPO_ENV=staging npm run build",
    "build:testing": "cross-env EXPO_ENV=testing npm run build",
    "build:local": "expo export --platform web && node scripts/post-build-local.js && node update-cache-version.js",
    "serve:local": "npm run build:local && npx serve dist -p 8080",
    "cache:update": "node update-cache-version.js",
    "data:update": "node update-marketdata.js",
    "version:update": "npm version patch --no-git-tag-version && node update-cache-version.js",
    "deploy": "npm run build && npm run deploy:gh-pages",
    "deploy:gh-pages": "gh-pages -d dist -t --dotfiles",
    "validate": "./scripts/validate-release.sh",
    "prepare": "husky install",
    "lint:workflows": "node scripts/lint-workflows.js"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^3.1.1",
    "expo": "~57.0.20",
    "expo-linear-gradient": "~57.0.1",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.21",
    "html-to-image": "^1.11.13",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-native": "0.87.1",
    "react-native-reanimated": "4.6.0",
    "react-native-safe-area-context": "~5.9.1",
    "react-native-svg": "15.15.5",
    "react-native-view-shot": "^5.1.1",
    "react-native-web": "~0.21.2",
    "react-native-worklets": "0.12.1"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.18",
    "@types/react-test-renderer": "^19.1.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.57.1",
    "babel-jest": "~30.5.1",
    "babel-plugin-dynamic-import-node": "^2.3.3",
    "babel-preset-expo": "~57.0.10",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-jest": "^29.16.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-native": "^5.0.0",
    "gh-pages": "^6.3.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jest": "~30.5.1",
    "jest-environment-jsdom": "~30.5.1",
    "lint-staged": "^17.5.0",
    "prettier": "^3.9.6",
    "react-test-renderer": "19.2.8",
    "typescript": "~7.0.2"
  },
  "overrides": {
    "node-forge": "^1.3.2",
    "undici": "^6.23.0",
    "diff": "^8.0.3",
    "tar": "^7.5.3",
    "uuid": "^11.1.1"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --no-warn-ignored",
      "prettier --write"
    ]
  },
  "private": true
}
