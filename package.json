{
  "name": "energypricegermany",
  "version": "1.4.0",
  "description": "Energy price visualization for Germany with market data and renewable energy share",
  "main": "index.ts",
  "homepage": "https://s540d.github.io/Energy_Price_Germany/",
  "repository": {
    "type": "git",
    "url": "https://github.com/S540d/Energy_Price_Germany.git"
  },
  "bugs": {
    "url": "https://github.com/S540d/Energy_Price_Germany/issues"
  },
  "license": "MIT",
  "author": "S540d",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx}\"",
    "build": "expo export --platform web && node scripts/post-build.js && node update-cache-version.js",
    "build:web": "cross-env EXPO_ENV=production npm run build",
    "build:production": "cross-env EXPO_ENV=production npm run build",
    "build:staging": "cross-env EXPO_ENV=staging npm run build",
    "build:testing": "cross-env EXPO_ENV=testing npm run build",
    "build:local": "expo export --platform web && node scripts/post-build-local.js && node update-cache-version.js",
    "serve:local": "npm run build:local && npx serve dist -p 8080",
    "cache:update": "node update-cache-version.js",
    "data:update": "node update-marketdata.js",
    "version:update": "npm version patch --no-git-tag-version && node update-cache-version.js",
    "deploy": "npm run build && npm run deploy:gh-pages",
    "deploy:gh-pages": "gh-pages -d dist -t --dotfiles",
    "validate": "./scripts/validate-release.sh",
    "prepare": "husky install"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "expo": "~54.0.33",
    "expo-status-bar": "~3.0.9",
    "expo-updates": "~29.0.16",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "^5.6.2",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.1"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.28.5",
    "@babel/preset-flow": "^7.27.1",
    "@babel/preset-react": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@react-native/eslint-config": "^0.84.0",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.1.0",
    "@types/react-test-renderer": "^19.1.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "babel-jest": "~29.7.0",
    "cross-env": "^10.1.0",
    "dotenv": "^17.2.3",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^28.14.0",
    "gh-pages": "^6.3.0",
    "husky": "^9.1.7",
    "jest": "~29.7.0",
    "jest-environment-jsdom": "~29.7.0",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "react-test-renderer": "^19.1.0",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "node-forge": "^1.3.2",
    "undici": "^6.23.0",
    "diff": "^8.0.3",
    "tar": "^7.5.3",
    "eslint-plugin-jest": "$eslint-plugin-jest"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "private": true
}
