{
  "name": "energypricegermany",
  "version": "1.3.0",
  "description": "Energy price visualization for Germany with market data and renewable energy share",
  "main": "index.ts",
  "homepage": "https://s540d.github.io/Energy_Price_Germany/",
  "repository": {
    "type": "git",
    "url": "https://github.com/S540d/Energy_Price_Germany.git"
  },
  "bugs": {
    "url": "https://github.com/S540d/Energy_Price_Germany/issues"
  },
  "license": "MIT",
  "author": "S540d",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "build": "expo export --platform web && node scripts/post-build.js && node update-cache-version.js",
    "build:web": "cross-env EXPO_ENV=production npm run build",
    "build:production": "cross-env EXPO_ENV=production npm run build",
    "build:staging": "cross-env EXPO_ENV=staging npm run build",
    "build:testing": "cross-env EXPO_ENV=testing npm run build",
    "build:local": "expo export --platform web && node scripts/post-build-local.js && node update-cache-version.js",
    "serve:local": "npm run build:local && npx serve dist -p 8080",
    "cache:update": "node update-cache-version.js",
    "data:update": "node update-marketdata.js",
    "version:update": "npm version patch --no-git-tag-version && node update-cache-version.js",
    "deploy": "npm run build && npm run deploy:gh-pages",
    "deploy:gh-pages": "gh-pages -d dist -t --dotfiles",
    "validate": "./scripts/validate-release.sh",
    "prepare": "husky install",
    "eas:build:testing": "eas build --profile testing --platform all",
    "eas:build:staging": "eas build --profile staging --platform all",
    "eas:build:production": "eas build --profile production --platform all",
    "eas:build:android:testing": "eas build --profile testing --platform android",
    "eas:build:android:staging": "eas build --profile staging --platform android",
    "eas:build:android:production": "eas build --profile production --platform android",
    "eas:build:ios:testing": "eas build --profile testing --platform ios",
    "eas:build:ios:staging": "eas build --profile staging --platform ios",
    "eas:build:ios:production": "eas build --profile production --platform ios"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "expo": "~54.0.12",
    "expo-status-bar": "~3.0.8",
    "expo-updates": "^29.0.12",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.4",
    "react-native-safe-area-context": "^5.6.2",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.1",
    "victory-native": "^41.20.1"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.28.5",
    "@babel/preset-flow": "^7.27.1",
    "@babel/preset-react": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.1.0",
    "@types/react-test-renderer": "^19.1.0",
    "babel-jest": "^30.2.0",
    "cross-env": "^10.1.0",
    "dotenv": "^17.2.3",
    "eas-cli": "^16.28.0",
    "gh-pages": "^6.3.0",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "react-test-renderer": "^19.1.0",
    "ts-jest": "^29.4.6",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "node-forge": "^1.3.2",
    "undici": "^6.23.0"
  },
  "private": true
}
