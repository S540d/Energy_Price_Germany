{
  "name": "energypricegermany",
  "version": "1.6.0",
  "description": "Energy price visualization for Germany with market data and renewable energy share",
  "main": "index.ts",
  "homepage": "https://s540d.github.io/Energy_Price_Germany/",
  "repository": {
    "type": "git",
    "url": "https://github.com/S540d/Energy_Price_Germany.git"
  },
  "bugs": {
    "url": "https://github.com/S540d/Energy_Price_Germany/issues"
  },
  "license": "MIT",
  "author": "S540d",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint \"**/*.{ts,tsx}\" \"scripts/**/*.js\"",
    "lint:fix": "eslint \"**/*.{ts,tsx}\" \"scripts/**/*.js\" --fix",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx}\"",
    "build": "expo export --platform web && node scripts/post-build.js && node update-cache-version.js",
    "build:web": "cross-env EXPO_ENV=production npm run build",
    "build:production": "cross-env EXPO_ENV=production npm run build",
    "build:staging": "cross-env EXPO_ENV=staging npm run build",
    "build:testing": "cross-env EXPO_ENV=testing npm run build",
    "build:local": "expo export --platform web && node scripts/post-build-local.js && node update-cache-version.js",
    "serve:local": "npm run build:local && npx serve dist -p 8080",
    "cache:update": "node update-cache-version.js",
    "data:update": "node update-marketdata.js",
    "version:update": "npm version patch --no-git-tag-version && node update-cache-version.js",
    "deploy": "npm run build && npm run deploy:gh-pages",
    "deploy:gh-pages": "gh-pages -d dist -t --dotfiles",
    "validate": "./scripts/validate-release.sh",
    "prepare": "husky install"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "expo": "~55.0.8",
    "expo-linear-gradient": "~55.0.9",
    "expo-splash-screen": "~55.0.12",
    "expo-status-bar": "~55.0.4",
    "expo-updates": "~55.0.15",
    "html-to-image": "^1.11.13",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.2",
    "react-native-reanimated": "4.2.3",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-svg": "15.15.4",
    "react-native-view-shot": "^4.0.3",
    "react-native-web": "~0.21.2",
    "react-native-worklets": "0.7.2"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.29.2",
    "@babel/preset-flow": "^7.27.1",
    "@babel/preset-react": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@eslint/compat": "^2.0.3",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "@typescript-eslint/eslint-plugin": "^8.57.1",
    "@typescript-eslint/parser": "^8.57.1",
    "babel-jest": "~30.3.0",
    "cross-env": "^10.1.0",
    "dotenv": "^17.3.1",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-jest": "^29.15.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-native": "^5.0.0",
    "gh-pages": "^6.3.0",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "jest": "~30.3.0",
    "jest-environment-jsdom": "~30.3.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "react-test-renderer": "19.2.0",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "node-forge": "^1.3.2",
    "undici": "^6.23.0",
    "diff": "^8.0.3",
    "tar": "^7.5.3"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --no-warn-ignored",
      "prettier --write"
    ]
  },
  "private": true
}
