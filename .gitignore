# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
credentials.json

# Signing documentation (contains fingerprints + key aliases – keep local only)
keystore/

# Build outputs (can be downloaded from EAS)
*.aab
*.apk
builds/

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Private documentation
PFLICHTENHEFT.md
FooterSpezifikation.md

# Local GitHub templates (from .templates submodule)
# Only track via submodule, ignore local copies
# .github/ISSUE_TEMPLATE/  # Now tracked directly in this repo
# .github/PULL_REQUEST_TEMPLATE/  # Already tracked directly
.github/scripts/
.github/workflows/implement-issue.yml
coverage/
