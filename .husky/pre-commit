#!/usr/bin/env sh
echo "Running pre-commit checks..."

# Run lint-staged (ESLint + Prettier on staged TS/TSX files)
npx lint-staged

# Check for console.log in staged files (except logger.ts, scripts directory, and build scripts)
echo "Checking for console.log statements..."
if git diff --cached --name-only | grep -E '\.(ts|tsx|js|jsx)$' | grep -v "utils/logger.ts" | grep -v "^scripts/" | grep -v "update-cache-version.js" | grep -v "update-marketdata.js" | xargs -I {} sh -c 'grep -n "console\.log\|console\.debug" "{}" 2>/dev/null || true' | grep -q .; then
  git diff --cached --name-only | grep -E '\.(ts|tsx|js|jsx)$' | grep -v "utils/logger.ts" | grep -v "^scripts/" | grep -v "update-cache-version.js" | grep -v "update-marketdata.js" | xargs -I {} sh -c 'grep -n "console\.log\|console\.debug" "{}" 2>/dev/null || true'
  echo "❌ ERROR: Found console.log/debug in staged files!"
  echo "Please remove debug statements before committing."
  exit 1
fi

# Check for Web APIs without Platform.OS check
echo "Checking for unsafe Web API usage..."
if git diff --cached --name-only | grep -E '\.(ts|tsx)$' | xargs grep -n "window\." 2>/dev/null | grep -v "Platform.OS === 'web'" | grep -v "// platform-safe"; then
  echo "❌ ERROR: Found window.* without Platform.OS check!"
  echo "Add 'Platform.OS === \"web\"' check or // platform-safe comment"
  exit 1
fi

if git diff --cached --name-only | grep -E '\.(ts|tsx)$' | xargs grep -n "localStorage\." 2>/dev/null | grep -v "Platform.OS === 'web'" | grep -v "// platform-safe"; then
  echo "❌ ERROR: Found localStorage without Platform.OS check!"
  echo "Use AsyncStorage for mobile or add Platform.OS check"
  exit 1
fi

# Check version consistency if package.json or app.json changed
if git diff --cached --name-only | grep -E "(package\.json|app\.json|App\.tsx|build\.gradle\.kts)" >/dev/null; then
  echo "Checking version consistency..."

  PACKAGE_VERSION=$(node -p "require('./package.json').version" 2>/dev/null)
  APP_JSON_VERSION=$(node -p "require('./app.json').expo.version" 2>/dev/null)

  if [ "$PACKAGE_VERSION" != "$APP_JSON_VERSION" ]; then
    echo "❌ ERROR: Version mismatch between package.json and app.json!"
    echo "package.json: $PACKAGE_VERSION"
    echo "app.json: $APP_JSON_VERSION"
    exit 1
  fi
fi

# ============================================================================
# SECURITY: Sensitive data checks on staged diff (+lines only)
# ============================================================================
echo "Checking for sensitive data in staged changes..."

# Get the diff of staged changes (only added lines)
STAGED_DIFF=$(git diff --cached -U0 | grep '^+' | grep -v '^+++')

# Check for SHA1/SHA256 signing fingerprints (XX:XX:XX:... colon-hex format)
if echo "$STAGED_DIFF" | grep -qiE '[0-9A-F]{2}(:[0-9A-F]{2}){19,}'; then
  echo "❌ ERROR: Potential signing fingerprint detected in staged changes!"
  echo "SHA1/SHA256 fingerprints must not be committed. Use Repository Secrets instead."
  echo "Affected lines:"
  echo "$STAGED_DIFF" | grep -iE '[0-9A-F]{2}(:[0-9A-F]{2}){19,}'
  exit 1
fi

# Check for hardcoded API keys or tokens (key = "value" patterns, not GitHub Secrets)
if echo "$STAGED_DIFF" | grep -qiE '(api[_-]?key|api[_-]?token|access[_-]?token|auth[_-]?token)\s*[=:]\s*["'"'"'][A-Za-z0-9+/=_-]{16,}'; then
  echo "❌ ERROR: Potential hardcoded API key/token detected in staged changes!"
  echo "Use Repository Secrets (\${{ secrets.MY_SECRET }}) instead of hardcoding tokens."
  exit 1
fi

# Warn (non-blocking) if keystore documentation or internal checklists are staged
SENSITIVE_DOCS=$(git diff --cached --name-only | grep -E '^(keystore/|docs/ANDROID_STORE_CHECKLIST\.md|docs/RELEASE_CHECKLIST\.md)')
if [ -n "$SENSITIVE_DOCS" ]; then
  echo ""
  echo "⚠️  WARNING: Internal/sensitive documentation files are staged:"
  echo "$SENSITIVE_DOCS"
  echo "   These files contain internal process details or signing information."
  echo "   Consider adding them to .gitignore if they should stay local only."
  echo "   Commit is NOT blocked – proceeding."
  echo ""
fi

echo "✅ Pre-commit checks passed!"
